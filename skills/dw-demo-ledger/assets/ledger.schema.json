{
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "area": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "candidate",
              "documented",
              "measured"
            ]
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "flag",
                    "app",
                    "licence",
                    "capability"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "expected": {},
                "probe": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "id",
                "expected"
              ],
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "flag",
                      "capability"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "expected": {
                    "type": "boolean"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notApplicable": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]*$"
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "probe": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "when"
              ],
              "additionalProperties": false
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "docs",
                    "source",
                    "release",
                    "migration",
                    "measurement"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "ref"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "area",
          "name",
          "skill",
          "status",
          "requires",
          "inputs",
          "checks",
          "notApplicable",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "area",
    "functions"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
