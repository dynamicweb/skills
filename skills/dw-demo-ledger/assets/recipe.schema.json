{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dynamicweb/skills/skills/dw-demo-ledger/assets/recipe.schema.json",
  "title": "Recipe: the replayable form of one ledger function",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "functions", "skill", "inputs", "modes", "steps", "debts", "verify", "provenOn", "traps"],
  "properties": {
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "functions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9.-]+$"}},
    "skill": {"type": "string", "pattern": "^dw-[a-z]+-[a-z0-9-]+$"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "required"],
      "properties": {
        "section": {"type": "string", "minLength": 1},
        "required": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "modes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcpOnly", "hosted", "local", "layerDelivered"],
      "properties": {
        "mcpOnly": {"$ref": "#/definitions/mode"},
        "hosted": {"$ref": "#/definitions/mode"},
        "local": {"type": "object", "additionalProperties": false, "required": ["usable"], "properties": {"usable": {"const": true}, "reason": {"type": "string"}}},
        "layerDelivered": {"enum": ["verify", "apply", "both"]}
      }
    },
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/step"}},
    "debts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(flush:[A-Za-z][A-Za-z0-9_.]*|index:[A-Za-z0-9 _-]+/[A-Za-z0-9 _.-]+\\.index|assortments|recycle)$"}
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkIds", "probes"],
      "properties": {
        "checkIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "probes": {"type": "array", "items": {"$ref": "#/definitions/probe"}}
      }
    },
    "provenOn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dwVersion", "mcpVersion", "date", "evidence"],
        "properties": {
          "dwVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+"},
          "mcpVersion": {"type": "string", "minLength": 1},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "traps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependsOn": {
      "description": "Recipes whose objects this one needs, so a recipe set runs them first. debtsPaid names debts of that recipe that must be paid before this one runs, because a step here reads what they refresh.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipe", "why"],
        "properties": {
          "recipe": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z0-9-]+$"},
          "why": {"type": "string", "minLength": 1},
          "debtsPaid": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "runsLast": {"description": "Why a recipe set runs this recipe after every other one (a de-brand replaces text the others may write).", "type": "string", "minLength": 1}
  },
  "definitions": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usable", "reason"],
      "properties": {"usable": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}}
    },
    "mapSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "key", "value"],
      "properties": {
        "from": {"description": "A token or object resolving to {name: value}."},
        "key": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "skipWhen": {
      "description": "One condition, or a list that skips when any of them holds.",
      "oneOf": [{"$ref": "#/definitions/condition"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/condition"}}]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "^(input|item|parent)(\\.[A-Za-z0-9_]+)+$"},
        "exists": {"type": "boolean"},
        "equals": {},
        "notEquals": {},
        "contains": {"type": "string"}
      },
      "minProperties": 2,
      "maxProperties": 2
    },
    "plannedRule": {
      "if": {"properties": {"status": {"const": "planned"}}, "required": ["status"]},
      "then": {"required": ["reason"]}
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "status", "source"],
      "properties": {
        "id": {"type": "string"},
        "surface": {"enum": ["mcp", "admin-api", "sql", "dwapi"]},
        "status": {"enum": ["implemented", "planned"]},
        "reason": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "handler": {"enum": ["dwapi-get", "dwapi-signed-in-get", "dwapi-sign-in", "dwapi-persona-sign-in"]},
        "signIn": {"type": "object", "additionalProperties": false, "required": ["username", "password"], "description": "dwapi-signed-in-get only: the user the read signs in as; the password is a {secret.*} token.", "properties": {"username": {"type": "string", "minLength": 1}, "password": {"type": "string", "pattern": "^\\{secret\\.[^{}]+\\}$"}}},
        "operation": {"type": "string"},
        "arguments": {"type": "object"},
        "query": {"type": "string"},
        "parameters": {"type": "object", "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9]*$"}},
        "localOnly": {"type": "boolean"},
        "rows": {"type": "string"},
        "match": {"type": "object"},
        "compare": {"type": "object"},
        "expect": {"type": "object"},
        "compareMap": {"$ref": "#/definitions/mapSpec"},
        "expectMap": {"$ref": "#/definitions/mapSpec"},
        "produces": {"type": "object", "additionalProperties": {"type": "string"}},
        "assert": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["count", "equals", "contains", "excludes"]},
            "path": {"type": "string"},
            "op": {"enum": ["eq", "ge", "le"]},
            "value": {}
          }
        }
      },
      "allOf": [
        {"$ref": "#/definitions/plannedRule"},
        {"if": {"properties": {"surface": {"const": "sql"}}, "required": ["surface"]}, "then": {"required": ["localOnly", "query"], "properties": {"localOnly": {"const": true}}}},
        {"if": {"properties": {"surface": {"enum": ["mcp", "admin-api"]}, "status": {"const": "implemented"}}, "required": ["surface", "status"]}, "then": {"required": ["operation", "arguments"]}},
        {"if": {"properties": {"surface": {"const": "dwapi"}, "status": {"const": "implemented"}}, "required": ["surface", "status"]}, "then": {"required": ["operation", "handler"]}},
        {"if": {"properties": {"handler": {"const": "dwapi-signed-in-get"}}, "required": ["handler"]}, "then": {"required": ["signIn"]}}
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "arguments"],
      "properties": {"operation": {"type": "string", "minLength": 1}, "arguments": {"type": "object"}}
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "status", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "surface": {"enum": ["mcp", "admin-api"]},
        "status": {"enum": ["implemented", "planned"]},
        "reason": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "create": {"$ref": "#/definitions/operation"},
        "update": {"$ref": "#/definitions/operation"},
        "delete": {"$ref": "#/definitions/operation", "description": "A prune step's removal of one row; the arguments read the row as {row.<member>}. The operation must be on recipeDeleteTools."},
        "readBack": {"$ref": "#/definitions/read"}
      },
      "allOf": [
        {"$ref": "#/definitions/plannedRule"},
        {"if": {"properties": {"status": {"const": "implemented"}}, "required": ["status"]}, "then": {"required": ["readBack"], "anyOf": [{"required": ["create"]}, {"required": ["update"]}, {"required": ["delete"]}]}}
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "key", "bindings", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "forEach": {"type": "string", "pattern": "^[A-Za-z0-9_]+(\\[\\*\\])?(\\.[A-Za-z0-9_]+(\\[\\*\\])?)*$"},
        "key": {"type": "string", "minLength": 1},
        "skipWhen": {"$ref": "#/definitions/skipWhen"},
        "repeat": {"enum": ["reuse"], "description": "reuse: an item whose natural key an earlier item of this step already handled is skipped, for a shared object several items name (a product on several order lines)."},
        "after": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step", "states"],
          "properties": {
            "step": {"type": "string"},
            "states": {"type": "array", "minItems": 1, "items": {"enum": ["CREATED", "UPDATED", "UNCHANGED"]}}
          }
        },
        "find": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bindings"],
          "properties": {"bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/read"}}}
        },
        "scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "text", "replacement", "field", "identify"],
          "description": "A scan step: every row of the read whose field holds the text (ignoring case) is one place, named by its identify members; the write bindings' update reads the row as {row.<member>} and the replaced text as {replaced:row.<member>}. With no write binding each place is reported with unwritable.",
          "properties": {
            "binding": {"$ref": "#/definitions/read"},
            "page": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argument", "more", "next", "max"],
              "properties": {"argument": {"type": "string", "minLength": 1}, "more": {"type": "string", "minLength": 1}, "next": {"type": "string", "minLength": 1}, "max": {"type": "integer", "minimum": 1, "maximum": 1000}}
            },
            "text": {"type": "string", "minLength": 1},
            "replacement": {"type": "string"},
            "field": {"type": "string", "minLength": 1},
            "identify": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "unwritable": {"type": "string", "minLength": 1},
            "batch": {"type": "string", "minLength": 1, "description": "The list member of the update arguments: with batch, one call carries every place of the item, for a tool whose contract is one call per batch."}
          }
        },
        "prune": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "binding", "keep", "identify", "max"],
          "description": "A prune step: per scope value, every row the read returns (and its match selects) that the input does not name is removed through the delete binding. Refused when the scope is empty, when a row is outside the scope, or when more than max rows would go.",
          "properties": {
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": ["values", "member"],
              "properties": {
                "values": {"type": "string", "pattern": "^\\{[^{}]+\\}$", "description": "A token naming, from the input, the owners whose rows may be removed (one value or a list); the read takes each as {scope}."},
                "member": {"type": "string", "minLength": 1, "description": "The row member that must equal the scope value; a row without it or with another value refuses the item."}
              }
            },
            "binding": {"$ref": "#/definitions/read"},
            "keep": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "values"],
              "properties": {
                "field": {"type": "string", "minLength": 1, "description": "The row member holding the natural key."},
                "values": {"type": "string", "pattern": "^\\{[^{}]+\\}$", "description": "A token for the natural keys the input names; those rows are kept."}
              }
            },
            "identify": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "max": {"type": "integer", "minimum": 1, "maximum": 1000, "description": "More rows to remove than this refuses the item."}
          }
        },
        "bindings": {"type": "array", "items": {"$ref": "#/definitions/write"}, "description": "Write bindings in preference order. Empty for a lookup step, which finds and produces values and never writes; a lookup needs a find. A prune step's bindings declare delete."},
        "trap": {"type": "string"},
        "source": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["find"]}, {"required": ["after"]}, {"required": ["scan"]}, {"required": ["prune"]}]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "minimumSubjects", "bindings"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "title": {"type": "string", "minLength": 1},
        "forEach": {"type": "string", "pattern": "^[A-Za-z0-9_]+(\\[\\*\\])?(\\.[A-Za-z0-9_]+(\\[\\*\\])?)*$"},
        "skipWhen": {"$ref": "#/definitions/skipWhen"},
        "minimumSubjects": {"type": "integer", "minimum": 1},
        "pollSeconds": {"type": "integer", "minimum": 1, "maximum": 120, "description": "Repeat a failing read until it passes or this many seconds pass, for a state the platform publishes late (a new URL)."},
        "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/read"}}
      }
    }
  }
}
