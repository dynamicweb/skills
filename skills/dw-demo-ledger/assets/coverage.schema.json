{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema",
    "area",
    "retrieved",
    "sources",
    "claims",
    "gaps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "retrieved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "title"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sectionHash": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "functionId": {
            "type": "string",
            "minLength": 1
          },
          "duplicateOf": {
            "type": "string",
            "minLength": 1
          },
          "excluded": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "functionId"
            ]
          },
          {
            "required": [
              "duplicateOf"
            ]
          },
          {
            "required": [
              "excluded"
            ]
          }
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    }
  }
}
