{
  "schema": 1,
  "id": "search.facets.groups",
  "functionId": "search.facets",
  "intent": {
    "proves": "At least one facet group exists.",
    "level": "configured",
    "scope": "every facet group in every repository"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-get-index-facets",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_index_facets",
      "arguments": {}
    },
    {
      "id": "file-files-system-repositories-facets",
      "surface": "file",
      "status": "planned",
      "handler": "files-count",
      "path": "Files/System/Repositories/*/*.facets",
      "reason": "Repository definitions are XML files under Files/System/Repositories; an XML projection handler is not implemented and MCP file access to this folder is not granted by default."
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/repositories/facets.html"
    }
  ]
}
