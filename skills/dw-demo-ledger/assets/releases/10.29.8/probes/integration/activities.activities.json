{
  "schema": 1,
  "id": "integration.activities.activities",
  "functionId": "integration.activities",
  "intent": {
    "proves": "At least one integration activity exists.",
    "level": "applied",
    "scope": "all activities in all groups"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-get-integration-activities",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_integration_activities",
      "arguments": {}
    },
    {
      "id": "local-files",
      "surface": "file",
      "status": "implemented",
      "handler": "files-count",
      "localOnly": true,
      "arguments": {
        "folder": "Files\\Integration\\jobs",
        "filter": "*.xml",
        "includeSubfolders": true
      }
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/setup/activities.html"
    },
    {
      "kind": "source",
      "ref": "github.com/dynamicweb/MCP Integration/Tools (IntegrationActivityTools.cs, IntegrationEndpointTools.cs, IntegrationMappingTools.cs, IntegrationProviderTools.cs)"
    },
    {
      "kind": "source",
      "ref": "skills/dw-integration-framework/SKILL.md"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/index.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/architecture/architecture.html"
    }
  ]
}
