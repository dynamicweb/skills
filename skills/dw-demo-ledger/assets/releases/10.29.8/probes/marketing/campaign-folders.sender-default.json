{
  "schema": 1,
  "id": "marketing.campaign-folders.sender-default",
  "functionId": "marketing.campaign-folders",
  "intent": {
    "proves": "Every campaign folder carries a default sender email.",
    "level": "configured",
    "scope": "all campaign top folders"
  },
  "assertion": {
    "kind": "offenders"
  },
  "bindings": [
    {
      "id": "mcp-get-email-campaign-top-folders",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "get_email_campaign_top_folders",
      "arguments": {},
      "reason": "Handler not reserved: needs a field-predicate projection over the tool's rows; mcp-count counts rows only."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-offenders",
      "localOnly": true,
      "query": "SELECT CAST(TopFolderId AS nvarchar(20)) + N' ' + ISNULL(TopFolderName, N'') FROM EmailMarketingTopFolder WHERE ISNULL(TopFolderSenderEmail, N'') = N''"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/marketing/campaigns.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/marketing/emailmarketing.html"
    },
    {
      "kind": "source",
      "ref": "github.com/dynamicweb/MCP Marketing/Tools (EmailCampaignTools.cs, EmailRecipientTools.cs)"
    },
    {
      "kind": "source",
      "ref": "nuget Dynamicweb.EmailMarketing 10.29.8 (table and column names in assembly SQL strings)"
    }
  ]
}
