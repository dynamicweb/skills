{
  "schema": 1,
  "id": "marketing.scheduled-send.scheduled",
  "functionId": "marketing.scheduled-send",
  "intent": {
    "proves": "At least one email has an active schedule.",
    "level": "configured",
    "scope": "all emails"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-get-email-campaigns",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "get_email_campaigns",
      "arguments": {},
      "reason": "Handler not reserved: needs a field-predicate projection over the tool's rows; mcp-count counts rows only. Predicate: isScheduled = true."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EmailMarketingEmail WHERE EmailScheduledActive = 1 AND EmailScheduledSendTime IS NOT NULL"
    }
  ],
  "sources": [
