    "level": "configured",
    "scope": "all ledger types"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-count",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_ledger_types",
      "arguments": {}
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomLedgerTypes"
    }
  ],
