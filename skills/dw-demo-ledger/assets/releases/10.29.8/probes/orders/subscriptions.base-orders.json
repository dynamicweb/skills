{
  "schema": 1,
  "id": "orders.subscriptions.base-orders",
  "functionId": "orders.subscriptions",
  "intent": {
    "proves": "At least one recurring order schedule exists.",
    "level": "applied",
    "scope": "all recurring order schedules"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "get_recurring_orders_for_user",
      "reason": "Reads per user; a whole-host enumeration handler is not implemented."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomRecurringOrder"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/subscriptions.html"
    }
  ]
}
