{
  "schema": 1,
  "id": "content.pages.exist",
  "functionId": "content.pages",
  "intent": {
    "proves": "At least one page exists outside the recycle bin.",
    "level": "configured",
    "scope": "all pages in all websites"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-search-pages",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "search_pages",
      "arguments": {}
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM Page WHERE PageDeleted = 0"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/pages.html"
    },
    {
      "kind": "source",
      "ref": "https://github.com/dynamicweb/MCP/blob/main/Content/Tools/ContentSearchTools.cs"
    }
  ]
}
