{
  "schema": 1,
  "id": "content.redirects.active",
  "functionId": "content.redirects",
  "intent": {
    "proves": "At least one active redirect exists.",
    "level": "configured",
    "scope": "all redirect rows"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "admin-api",
      "surface": "admin-api",
      "status": "planned",
      "handler": "admin-query",
      "operation": "UrlPath list",
      "reason": "Admin query name for redirects not verified; no MCP tool reads redirects."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM UrlPath WHERE UrlPathActive = 1"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/webhttp/redirects.html"
    }
  ]
}
