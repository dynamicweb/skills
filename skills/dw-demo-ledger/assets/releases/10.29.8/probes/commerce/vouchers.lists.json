{
  "schema": 1,
  "id": "commerce.vouchers.lists",
  "functionId": "commerce.vouchers",
  "intent": {
    "proves": "At least one voucher list exists.",
    "level": "configured",
    "scope": "all voucher lists"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-count",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_voucher_sets",
      "arguments": {}
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomVoucherLists WHERE VoucherListActive = 1"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/promotions/vouchers.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/apps/voucherrenderer.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/marketing/voucher-emails.html"
    }
  ]
}
