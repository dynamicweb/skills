{
  "schema": 1,
  "id": "commerce.product-catalog-app.paragraph",
  "functionId": "commerce.product-catalog-app",
  "intent": {
    "proves": "At least one paragraph runs the Product Catalog app.",
    "level": "configured",
    "scope": "all paragraphs of all areas, module system name eCom_ProductCatalog"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-count",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "search_paragraphs",
      "arguments": {
        "moduleSystemName": "eCom_ProductCatalog"
      }
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM Paragraph WHERE ParagraphModuleSystemName = N'eCom_ProductCatalog' AND ISNULL(ParagraphDeleted, 0) = 0"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/apps/product-catalog-viewmodel.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/apps/product-catalog.html"
    }
  ]
}
