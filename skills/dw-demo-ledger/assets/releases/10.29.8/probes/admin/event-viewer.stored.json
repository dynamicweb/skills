{
  "schema": 1,
  "id": "admin.event-viewer.stored",
  "functionId": "admin.event-viewer",
  "intent": {
    "proves": "Events are being stored in the event store.",
    "level": "configured",
    "scope": "every stored event"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-categories",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_unique_log_event_categories",
      "arguments": {}
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM GeneralLog"
    }
  ],
  "sources": [
    {
