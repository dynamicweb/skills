{
  "schema": 1,
  "id": "admin.scheduled-task-subtasks.has-subtasks",
  "functionId": "admin.scheduled-task-subtasks",
  "intent": {
    "proves": "At least one scheduled task carries subtasks.",
    "level": "configured",
    "scope": "every ScheduledTask row with a parent task"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-get-scheduled-tasks",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-subtask-count",
      "operation": "get_scheduled_tasks",
      "arguments": {
        "includeSubTasks": true
      },
      "reason": "mcp-count would count parents too; needs a ParentId projection handler."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM ScheduledTask WHERE TaskParentId IS NOT NULL"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/system/scheduledtasks.html"
    },
    {
      "kind": "source",
      "ref": "skills/dw-extend-scheduled-tasks/references/scheduler-rows-and-runs.md"
    }
  ]
}
