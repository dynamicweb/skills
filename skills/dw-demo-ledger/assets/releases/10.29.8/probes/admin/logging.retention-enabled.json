{
  "schema": 1,
  "id": "admin.logging.retention-enabled",
  "functionId": "admin.logging",
  "intent": {
    "proves": "Delete logs automatically is checked with a file and a database retention period.",
    "level": "configured",
    "scope": "solution-wide setting"
  },
  "assertion": {
    "kind": "scalar",
    "op": "eq",
    "value": 1
  },
  "bindings": [
    {
      "id": "file-globalsettings-key",
      "surface": "file",
      "status": "planned",
      "handler": "globalsettings-key",
      "path": "GlobalSettings.config",
      "reason": "The GlobalSettings keys behind Log retention are unverified."
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/system/logRetention.html"
    },
    {
      "kind": "source",
      "ref": "skills/dw-setup-config/references/tracking-insights.md"
    }
  ]
}
