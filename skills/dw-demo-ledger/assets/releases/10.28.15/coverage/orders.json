  "claims": [
    {
      "claim": "Order management lists are filtered by the user's shop read permissions.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "excluded": {
        "reason": "Backend permission filtering is owned by the users-permissions area."
      }
    },
    {
      "claim": "A cart is converted to an order when checkout completes in the Shopping Cart app.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.completed-orders"
    },
    {
      "claim": "Multiple named carts and cart flows pass carts between customer and business before checkout.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.named-carts"
    },
    {
      "claim": "A cart can be checked out to a quote that staff edit and the customer accepts or rejects.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.quotes"
    },
    {
      "claim": "Orders come from checkout, subscriptions, quote conversion or external import.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.completed-orders"
    },
    {
      "claim": "Order fields and order line fields extend the standard fields.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.order-fields"
    },
    {
      "claim": "Subscription base orders generate orders at intervals.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.subscriptions"
    },
    {
      "claim": "Incomplete orders are kept out of the Orders list until payment is confirmed.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Orders are processed by moving them through order flow states.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.order-flows"
    },
    {
      "claim": "Payment can be captured from the back office for providers that support it; capture states are tracked.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Shipping uses fee rules or a carrier provider.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.shipping-fees"
    },
    {
      "claim": "A shipped state with track and trace sends a tracking email.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.track-and-trace"
    },
    {
      "claim": "Cancel, delete and refund are available when the payment provider supports them.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Fulfilled orders are returned through RMA, optionally with a replacement order.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.rma"
    },
    {
      "claim": "Ledger entries record invoices, credit memos and payments tied to orders.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/index.html",
      "functionId": "orders.ledgers"
    },
    {
      "claim": "The Orders list supports search, filters, columns and saved views.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/orders.html",
      "excluded": {
        "reason": "Back-office list presentation (columns, views, sorting) is generic screen behaviour, not a commerce outcome."
      }
    },
    {
      "claim": "Row actions: capture, change flow and state, shipping documents, receipt, register RMA, edit, cancel, delete.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/orders.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Order details show overview, payment details, information, recurring and custom fields tabs.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/orders.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Order lines are added by search or SKU, as fixed lines or order discounts, in the Order lines widget.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/orders.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Editing an order changes currency, channel, PO number, voucher, addresses, methods, comments, track and trace and other fields.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/orders.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Selected orders export to Excel, optionally with an export template.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/orders.html",
      "functionId": "orders.order-export"
    },
    {
      "claim": "The Carts list shows open carts with state, customer, lines and price.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/carts.html",
      "functionId": "orders.cart-flows"
    },
    {
      "claim": "Carts can be edited, moved through cart flow states, viewed as frontend receipt or deleted.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/carts.html",
      "functionId": "orders.cart-flows"
    },
    {
      "claim": "Incomplete orders show an age indicator (in payment, delayed, stuck).",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/incomplete-orders.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Incomplete orders complete automatically if payment is later confirmed; they can be edited, viewed or deleted.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/incomplete-orders.html",
      "functionId": "orders.order-processing"
    },
    {
      "claim": "Quotes are listed and moved through quote flow states; they can be edited or deleted.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/quotes.html",
      "functionId": "orders.quotes"
    },
    {
      "claim": "Subscriptions list base orders; previous and future deliveries, cancel recurring, edit, delete and new subscription.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/subscriptions.html",
      "functionId": "orders.subscriptions"
    },
    {
      "claim": "A base order holds start date, end date, interval and interval unit and is usually created from frontend.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/subscriptions.html",
      "functionId": "orders.subscriptions"
    },
    {
      "claim": "RMAs are Return, Defective or Exchange, created from an order or the customer center.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/rma.html",
      "functionId": "orders.rma"
    },
    {
      "claim": "RMAs move through states and are closed; closed or deleted RMAs are read-only.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/rma.html",
      "functionId": "orders.rma"
    },
    {
      "claim": "A replacement order (refund, replace with different or same product) is created at the end of the RMA flow.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/rma.html",
      "functionId": "orders.rma"
    },
    {
      "claim": "Ledger entries are listed per ledger type and moved through ledger flows.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/ledgers.html",
      "functionId": "orders.ledgers"
    },
    {
      "claim": "Ledger entries are imported from an external system and shown in the Customer Experience Center.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/ledgers.html",
      "functionId": "orders.ledgers"
    },
    {
      "claim": "Order management settings group payment, shipping, stock state, fields, flows, contexts, track and trace and validation.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/index.html",
      "functionId": "orders.order-flows"
    },
    {
      "claim": "Payment methods have name, active state, description, countries, provider, fees and frontend groups.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/payment.html",
      "functionId": "orders.payment-methods"
    },
    {
      "claim": "Checkout handlers keep card data on the provider's page (PCI scope).",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/payment.html",
      "functionId": "orders.payment-providers"
    },
    {
      "claim": "Payment fees are fixed or percentage above a total, per country or region.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/payment.html",
      "functionId": "orders.payment-fees"
    },
    {
      "claim": "Payment methods are active for selected delivery countries or all countries.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/payment.html",
      "functionId": "orders.method-countries"
    },
    {
      "claim": "Business Central code, terms code and terms map a payment method to the ERP.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/payment.html",
      "excluded": {
        "reason": "Live ERP integration features are owned by the integration area (dw-integration-erp)."
      }
    },
    {
      "claim": "Shipping methods have name, active state, description, provider, fees, availability and Business Central fields.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/shipping.html",
      "functionId": "orders.shipping-methods"
    },
    {
      "claim": "A shipping provider app integrates a carrier such as GLS or Shipmondo.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/shipping.html",
      "functionId": "orders.shipping-providers"
    },
    {
      "claim": "Default fee, no fee above an amount and eligibility for free shipping discounts.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/shipping.html",
      "functionId": "orders.free-shipping"
    },
    {
      "claim": "Fee rules by date, fee type, weight, volume, user, group, customer number, shop, product, group, total, context, country, region, currency and zip.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/shipping.html",
      "functionId": "orders.shipping-fees"
    },
    {
      "claim": "Shipping methods are available for selected countries and regions.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/shipping.html",
      "functionId": "orders.method-countries"
    },
    {
      "claim": "Shipping methods are limited by frontend groups, products and groups (inclusive or exclusive) and weight limits.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/shipping.html",
      "functionId": "orders.shipping-methods"
    },
    {
      "claim": "Business Central agent and service codes map a shipping method to the ERP.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/shipping.html",
      "excluded": {
        "reason": "Live ERP integration features are owned by the integration area (dw-integration-erp)."
      }
    },
    {
