{
  "schema": 1,
  "id": "content.item-pages.in-use",
  "functionId": "content.item-pages",
  "intent": {
    "proves": "At least one non-deleted page uses a page item type.",
    "level": "applied",
    "scope": "non-deleted pages"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-search-pages",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "search_pages",
      "arguments": {},
      "reason": "search_pages filters by one named item type; counting any item type needs a projection."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM Page WHERE PageDeleted = 0 AND ISNULL(PageItemType, N'') <> N''"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/pages.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/content/itemtypes.html"
    }
  ]
}
