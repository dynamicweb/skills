{
  "schema": 1,
  "id": "content.url-provider.configured",
  "functionId": "content.url-provider",
  "intent": {
    "proves": "At least one page has a URL provider configured.",
    "level": "configured",
    "scope": "non-deleted pages"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-search-pages",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "search_pages",
      "arguments": {},
      "reason": "search_pages rows do not expose the URL provider setting."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM Page WHERE PageDeleted = 0 AND ISNULL(PageUrlDataProvider, N'') <> N''"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/url-provider.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/pages.html"
    }
  ]
}
