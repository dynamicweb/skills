{
  "schema": 1,
  "id": "search.file-index.defined",
  "functionId": "search.file-index",
  "intent": {
    "proves": "At least one index uses the file index builder.",
    "level": "configured",
    "scope": "index definitions in every repository"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "file-files-system-repositories-index",
      "surface": "file",
      "status": "implemented",
      "handler": "xml-count",
      "path": "System/Repositories/*/*.index",
      "localOnly": true,
      "arguments": {
        "xpath": "/Index/Builds[substring-before(@Type, ',') = 'Dynamicweb.Content.Files.FileIndexBuilder']"
      }
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/documentation/implementing/repositories/indexes/index.html"
    }
  ]
}
