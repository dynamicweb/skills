{
  "schema": 1,
  "id": "marketing.emails.emails",
  "functionId": "marketing.emails",
  "intent": {
    "proves": "At least one email (not a template) exists.",
    "level": "applied",
    "scope": "all emails excluding templates; complete enumeration"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-get-email-campaigns",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_email_campaigns",
      "arguments": {
        "includeTemplates": false
      }
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EmailMarketingEmail WHERE ISNULL(EmailIsTemplate, 0) = 0"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/marketing/emails.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/marketing/emailmarketing.html"
    },
    {
      "kind": "source",
      "ref": "github.com/dynamicweb/MCP Marketing/Tools (EmailCampaignTools.cs, EmailRecipientTools.cs)"
    },
    {
      "kind": "source",
      "ref": "nuget Dynamicweb.EmailMarketing 10.29.8 (table and column names in assembly SQL strings)"
    }
  ]
}
