{
  "schema": 1,
  "id": "orders.quotes.submitted",
  "functionId": "orders.quotes",
  "intent": {
    "proves": "At least one quote exists.",
    "level": "behavioural",
    "scope": "all non-deleted orders flagged as quote"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "search_orders",
      "reason": "The skills record that search_orders does not return quotes; read quotes with get_orders_by_ids, which needs ids."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomOrders WHERE OrderIsQuote = 1 AND ISNULL(OrderDeleted, 0) = 0"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/quotes.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/quoteflows.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/apps/customer-experience-center.html"
    },
    {
      "kind": "source",
      "ref": "DW10 database schema (INFORMATION_SCHEMA of a local DW10 install) and Dynamicweb.Ecommerce 10.29.8"
    }
  ]
}
