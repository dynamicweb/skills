{
  "schema": 1,
  "id": "orders.payment-methods.active",
  "functionId": "orders.payment-methods",
  "intent": {
    "proves": "At least one payment method is active.",
    "level": "configured",
    "scope": "all payment methods"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-count",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_payment_methods",
      "arguments": {
        "onlyActive": true
      }
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(DISTINCT PaymentId) FROM EcomPayments WHERE PaymentActive = 1"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/payment.html"
    }
  ]
}
