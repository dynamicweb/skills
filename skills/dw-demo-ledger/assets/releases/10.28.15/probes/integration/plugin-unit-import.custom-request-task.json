{
  "schema": 1,
  "id": "integration.plugin-unit-import.custom-request-task",
  "functionId": "integration.plugin-unit-import",
  "intent": {
    "proves": "An enabled scheduled task runs the Import data with custom request add-in.",
    "level": "configured",
    "scope": "all scheduled tasks, both levels"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "planned",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM ScheduledTask WHERE TaskEnabled = 1 AND TaskAddInTypeName LIKE N'%CustomRequest%'",
      "reason": "Add-in type name of Import data with custom request not verified."
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/guides/plugin-unit-integration/bc-cloud.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/erp-plug-in-units/index.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/architecture/architecture.html"
    }
  ]
}
