{
  "schema": 1,
  "id": "integration.scheduled-runs.schedules",
  "functionId": "integration.scheduled-runs",
  "intent": {
    "proves": "At least one enabled scheduled task runs an integration activity.",
    "level": "configured",
    "scope": "all scheduled tasks, both levels"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-get-integration-activities",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "get_integration_activities",
      "arguments": {},
      "reason": "Handler not reserved: needs a field-predicate projection over the tool's rows; mcp-count counts rows only. Predicate: isScheduled and enabled."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM ScheduledTask WHERE TaskEnabled = 1 AND TaskAddInTypeName LIKE N'%JobScheduledTaskAddIn%'"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/setup/activities.html"
    },
    {
      "kind": "source",
      "ref": "github.com/dynamicweb/MCP Integration/Tools (IntegrationActivityTools.cs, IntegrationEndpointTools.cs, IntegrationMappingTools.cs, IntegrationProviderTools.cs)"
    },
    {
      "kind": "source",
      "ref": "skills/dw-integration-framework/SKILL.md"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/integration/scheduledtasks.html"
    },
    {
      "kind": "source",
      "ref": "skills/dw-extend-scheduled-tasks/references/scheduler-rows-and-runs.md (ScheduledTask row contract)"
    }
  ]
}
