{
  "schema": 1,
  "id": "commerce.stock-locations.locations",
  "functionId": "commerce.stock-locations",
  "intent": {
    "proves": "At least one stock location exists.",
    "level": "configured",
    "scope": "all stock locations"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-count",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_stock_locations",
      "arguments": {}
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(DISTINCT StockLocationId) FROM EcomStockLocation"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/product-catalog/stocklocations.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/product-catalog/stocklocationcategories.html"
    }
  ]
}
