{
  "schema": 1,
  "id": "commerce.stock-matrix.entries",
  "functionId": "commerce.stock-matrix",
  "intent": {
    "proves": "At least one stock unit entry has a quantity above zero.",
    "level": "applied",
    "scope": "all EcomStockUnit rows"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "get_product_stock_by_location",
      "reason": "Reads one product and location per call; no whole-host enumeration tool."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomStockUnit WHERE StockUnitQuantity > 0"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/stock.html"
    }
  ]
}
