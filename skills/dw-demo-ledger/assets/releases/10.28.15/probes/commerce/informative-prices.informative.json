{
  "schema": 1,
  "id": "commerce.informative-prices.informative",
  "functionId": "commerce.informative-prices",
  "intent": {
    "proves": "At least one price matrix entry is marked informative.",
    "level": "applied",
    "scope": "all EcomPrices rows"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "get_prices_by_product_id",
      "reason": "get_prices_by_product_id reads prices per product; no whole-host price enumeration tool exists, so a host-wide count is not an equivalent observation."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomPrices WHERE PriceIsInformative = 1"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html"
    }
  ]
}
