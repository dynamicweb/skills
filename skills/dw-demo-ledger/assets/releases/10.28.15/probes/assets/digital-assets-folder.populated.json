{
  "schema": 1,
  "id": "assets.digital-assets-folder.populated",
  "functionId": "assets.digital-assets-folder",
  "intent": {
    "proves": "The digital assets folder contains at least one file.",
    "level": "applied",
    "scope": "files under /Files/Digital assets, including subfolders"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-list-files",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-files-count",
      "operation": "list_files",
      "arguments": {
        "path": "/Files/Digital assets"
      },
      "reason": "list_files is not recursive and returns folders too; a recursive file-only count handler is needed."
    },
    {
      "id": "local-files",
      "surface": "file",
      "status": "implemented",
      "handler": "files-count",
      "localOnly": true,
      "arguments": {
        "folder": "Digital assets",
        "filter": "*.*",
        "includeSubfolders": true
      }
    }
  ],
  "sources": [
    {
      "kind": "source",
      "ref": "https://github.com/dynamicweb/MCP/blob/main/Content/Tools/FileTools.cs"
    }
  ]
}
