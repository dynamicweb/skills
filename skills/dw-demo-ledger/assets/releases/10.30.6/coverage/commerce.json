  "claims": [
    {
      "claim": "A dashboard shows daily orders, average order value and conversion rate.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/index.html",
      "excluded": {
        "reason": "Commerce dashboard metrics are owned by the insights/dashboards area."
      }
    },
    {
      "claim": "An assortments section creates product collections for frontend.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/index.html",
      "duplicateOf": "pim.assortments"
    },
    {
      "claim": "A promotions section holds discounts, voucher codes and loyalty points.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/index.html",
      "functionId": "commerce.discounts"
    },
    {
      "claim": "Discounts reduce the selling price of products or orders.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/promotions/index.html",
      "functionId": "commerce.discounts"
    },
    {
      "claim": "New Discount Experience bundles rewards and conditions in one discount.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/promotions/index.html",
      "functionId": "commerce.discounts-v2"
    },
    {
      "claim": "Vouchers are unique single-use codes that trigger a discount at checkout.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/promotions/index.html",
      "functionId": "commerce.vouchers"
    },
    {
      "claim": "Loyalty points are awarded by rewards and rules and spent on products or as a cash discount.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/promotions/index.html",
      "functionId": "commerce.loyalty-rewards"
    },
    {
      "claim": "Gift cards generate a code when sold that pays during checkout; the list shows remaining balances.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/promotions/index.html",
      "functionId": "commerce.gift-cards"
    },
    {
      "claim": "Every product has a default price in the default currency, converted at the currency rate.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.default-price"
    },
    {
      "claim": "The price matrix holds multiple price entries per product scoped by currency, country, customer, quantity and date.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.price-matrix"
    },
    {
      "claim": "Explicit prices per currency override conversion from the default currency.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.currency-prices"
    },
    {
      "claim": "A price entry is either with or without VAT; VAT is back-calculated per country.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.price-matrix"
    },
    {
      "claim": "Informative prices show RRP or before prices and are never applied to an order.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.informative-prices"
    },
    {
      "claim": "A discount percentage on a price entry reduces it; discount-only entries discount the lowest matching price.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.price-discount-lines"
    },
    {
      "claim": "Allow order line discounts and allow order discounts per price entry control discount participation.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.price-matrix"
    },
    {
      "claim": "Priority on price entries makes the highest-priority price win over a lower price.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.price-priority"
    },
    {
      "claim": "Quantity thresholds create tiered prices, optionally across all variants (Any variants).",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.quantity-prices"
    },
    {
      "claim": "Valid from and valid to dates create time-limited prices.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.time-limited-prices"
    },
    {
      "claim": "Prices can target a single user.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.customer-prices"
    },
    {
      "claim": "Prices can target a user group for tiered B2B pricing.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.customer-prices"
    },
    {
      "claim": "Prices can target an ERP customer number or group customer number.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.customer-prices"
    },
    {
      "claim": "Prices can be restricted to a variant.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.market-prices"
    },
    {
      "claim": "Prices can differ per unit of measure.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.unit-prices"
    },
    {
      "claim": "Prices can differ per stock location.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.market-prices"
    },
    {
      "claim": "Prices can be restricted to a language.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.market-prices"
    },
    {
      "claim": "Prices can be restricted to a country for market-specific pricing.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.market-prices"
    },
    {
      "claim": "Prices can be restricted to a shop (sales channel).",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.market-prices"
    },
    {
      "claim": "Price resolution filters entries by context, applies priority, then picks the lowest effective price, else the default price.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/prices.html",
      "functionId": "commerce.price-matrix"
    },
    {
      "claim": "Product stock is an absolute value on the stock field, decremented on sale.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/stock.html",
      "functionId": "commerce.stock-levels"
    },
    {
      "claim": "The stock matrix holds stock per variant, unit and stock location with dimensions, never out of stock and expected delivery.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/stock.html",
      "functionId": "commerce.stock-matrix"
    },
    {
      "claim": "Product units define how many base units a unit contains; the first is the base unit.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/stock.html",
      "duplicateOf": "pim.sales-units"
    },
    {
      "claim": "Product reservation reserves stock at add to cart or at checkout for a number of minutes.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/managing-products/stock.html",
      "functionId": "commerce.product-reservation"
    },
    {
      "claim": "Unit types (box, pallet, pair) are defined under settings and priced through the price matrix.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/products/relations/product-units.html",
      "duplicateOf": "pim.sales-units"
    },
    {
      "claim": "Customer assortments limit logged-in users to a subset of products; assortments are enabled in channel settings.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/customerassortments.html",
      "duplicateOf": "pim.assortments"
    },
    {
      "claim": "Assortments contain channels, groups and products (with exclusions) and are granted to users and groups.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/customerassortments.html",
      "duplicateOf": "pim.assortments"
    },
    {
      "claim": "An anonymous assortment applies to visitors who are not logged in.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/customerassortments.html",
      "duplicateOf": "pim.assortments"
    },
    {
      "claim": "Assortments are rebuilt by the Build Ecommerce Assortment Items scheduled task or a manual rebuild.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/products/customerassortments.html",
      "duplicateOf": "pim.assortments"
    },
    {
      "claim": "The Build Ecommerce Assortment Items task rebuilds assortments flagged AssortmentRebuildRequired.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/system/scheduledtaskaddins/build-assortments.html",
      "duplicateOf": "pim.assortments"
    },
    {
      "claim": "Currencies have a rate against exactly one default currency.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/products/internationalization/currencies.html",
      "functionId": "commerce.currencies"
    },
    {
      "claim": "Currency regional info, code, symbol and positive and negative patterns control formatting.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/products/internationalization/currencies.html",
      "functionId": "commerce.currencies"
    },
    {
      "claim": "Rounding settings on a currency adjust displayed prices.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/products/internationalization/currencies.html",
      "functionId": "commerce.currency-rounding"
    },
    {
      "claim": "Stock locations are warehouses or stores, optionally categorised and linked to a user.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/product-catalog/stocklocations.html",
      "functionId": "commerce.stock-locations"
    },
    {
      "claim": "Stock location categories classify locations (click and collect, warehouse) for frontend filtering.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/product-catalog/stocklocationcategories.html",
      "functionId": "commerce.stock-locations"
    },
    {
      "claim": "Product catalog settings group tax settings, Vertex, stock locations and categories.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/product-catalog/index.html",
      "functionId": "commerce.stock-locations"
    },
    {
      "claim": "Stock states label stock levels with text, delivery time and icon and are tied to channels.",
      "url": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/ordermanagement/stockstate.html",
      "functionId": "commerce.stock-states"
    },
