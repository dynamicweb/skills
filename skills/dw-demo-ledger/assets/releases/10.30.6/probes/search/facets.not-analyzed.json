{
  "schema": 1,
  "id": "search.facets.not-analyzed",
  "functionId": "search.facets",
  "intent": {
    "proves": "No facet reads an analysed index field.",
    "level": "stored-integrity",
    "scope": "every facet in the repositories the build ships (build.repositories), joined to its index field definition; facets in other repository folders are reported as out of scope"
  },
  "assertion": {
    "kind": "offenders",
    "minimumSubjects": 1
  },
  "bindings": [
    {
      "id": "mcp-get-index-facets",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-facet-field-analyzed",
      "operation": "get_index_facets",
      "arguments": {},
      "reason": "MCP route: get_index_facets returns each facet's field name and no allowlisted read returns whether an index field is analysed; get_index_facet_fields (not allowlisted) returns systemName, name, group and typeName only (measured on 10.30.6 with Truvio.Commerce.MCP 0.6.3). Needs an analyzed property on an MCP read. The implemented local Files binding observes the same claim."
    },
    {
      "id": "files-repositories-facet-analyzed",
      "surface": "file",
      "status": "implemented",
      "handler": "files-facet-analyzed",
      "path": "System/Repositories/*/*.facets",
      "arguments": {
        "scope": "build-repositories",
