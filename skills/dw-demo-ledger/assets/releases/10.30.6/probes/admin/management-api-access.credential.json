{
  "schema": 1,
  "id": "admin.management-api-access.credential",
  "functionId": "admin.management-api-access",
  "intent": {
    "proves": "At least one unexpired API key or OAuth client exists.",
    "level": "configured",
    "scope": "API keys and OAuth clients"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "admin-api-admin-credential-count",
      "surface": "admin-api",
      "status": "planned",
      "handler": "admin-credential-count",
      "reason": "The list queries for keys and clients are unverified; the authenticated discovery read proves a working key, not this count."
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/developer/api-keys.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/developer/oauth.html"
    }
  ]
}
