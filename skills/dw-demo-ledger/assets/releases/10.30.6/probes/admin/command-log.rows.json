{
  "schema": 1,
  "id": "admin.command-log.rows",
  "functionId": "admin.command-log",
  "intent": {
    "proves": "The command log holds at least one command.",
    "level": "applied",
    "scope": "every CommandLog row"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-mcp-count",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "reason": "No MCP tool reads the command log in 0.6.3-BETA."
    },
    {
      "id": "admin-api-admin-command-log",
      "surface": "admin-api",
      "status": "planned",
      "handler": "admin-command-log",
      "reason": "The Management API query behind the CommandLog node is unverified."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM CommandLog"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/system/system/commandlog.html"
    },
    {
      "kind": "source",
      "ref": "skills/dw-setup-config/references/tracking-insights.md"
    }
  ]
}
