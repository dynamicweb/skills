{
  "schema": 1,
  "id": "marketing.flows.active-flows",
  "functionId": "marketing.flows",
  "intent": {
    "proves": "At least one active email flow exists.",
    "level": "configured",
    "scope": "all flows"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "admin-flowsbyfolderid",
      "surface": "admin-api",
      "status": "planned",
      "handler": "admin-query",
      "operation": "FlowsByFolderId",
      "reason": "Admin query named by the dashboard-seeding skill; per-folder enumeration and response projection not measured."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EmailMarketingFlow WHERE EmailMarketingFlowActive = 1"
    }
  ],
  "sources": [
