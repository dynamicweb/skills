{
  "schema": 1,
  "id": "marketing.email-templates.templates",
  "functionId": "marketing.email-templates",
  "intent": {
    "proves": "At least one reusable email template exists.",
    "level": "applied",
    "scope": "all emails flagged as template"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp-get-email-campaign-templates",
      "surface": "mcp",
      "status": "implemented",
      "handler": "mcp-count",
      "operation": "get_email_campaign_templates",
      "arguments": {}
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EmailMarketingEmail WHERE EmailIsTemplate = 1"
    }
  ],
  "sources": [
