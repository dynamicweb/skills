{
  "schema": 1,
  "id": "integration.live-cart-orders.remote-order-ids",
  "functionId": "integration.live-cart-orders",
  "intent": {
    "proves": "At least one completed order carries a remote order id.",
    "level": "behavioural",
    "scope": "completed orders; a batch export that writes back ids also satisfies it"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomOrders WHERE OrderComplete = 1 AND ISNULL(OrderIntegrationOrderID, N'') <> N''"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/setup/live.html"
    },
    {
      "kind": "docs",
