{
  "schema": 1,
  "id": "integration.provider-excel.source-file",
  "functionId": "integration.provider-excel",
  "intent": {
    "proves": "An Excel workbook is present in the integration file archive.",
    "level": "configured",
    "scope": "Files/Integration and subfolders"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
    "value": 1
  },
  "bindings": [
    {
      "id": "local-files",
      "surface": "file",
      "status": "implemented",
      "handler": "files-count",
      "localOnly": true,
      "arguments": {
        "folder": "Files\\Integration",
        "filter": "*.xlsx",
        "includeSubfolders": true
      }
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/setup/providers/excel-provider.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/integration/setup/providers/index.html"
    }
  ]
}
