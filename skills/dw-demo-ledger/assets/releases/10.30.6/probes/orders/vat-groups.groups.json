  "id": "orders.vat-groups.groups",
  "functionId": "orders.vat-groups",
  "intent": {
    "proves": "At least one VAT group exists.",
    "level": "configured",
    "scope": "all VAT groups"
  },
  "assertion": {
    "kind": "scalar",
    "op": "ge",
