{
  "schema": 1,
  "id": "orders.rma.default-state",
  "functionId": "orders.rma",
  "intent": {
    "proves": "Exactly one RMA state is the default for new RMAs.",
    "level": "configured",
    "scope": "all RMA states"
  },
  "assertion": {
    "kind": "scalar",
    "op": "eq",
    "value": 1
  },
  "bindings": [
    {
      "id": "mcp",
      "surface": "mcp",
      "status": "planned",
      "handler": "mcp-count",
      "operation": "get_rma_states",
      "reason": "mcp-count cannot filter on the default flag; a projection handler is not implemented."
    },
    {
      "id": "local-sql",
      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "localOnly": true,
      "query": "SELECT COUNT(*) FROM EcomRmaStates WHERE RmaStateIsDefaultStateForNewRma = 1"
    }
  ],
  "sources": [
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/commerce/ordermanagement/rma.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/settings/areas/commerce/rma/index.html"
    },
    {
      "kind": "docs",
      "ref": "https://doc.dynamicweb.dev/manual/dynamicweb10/content/apps/customer-experience-center-rma.html"
    },
    {
      "kind": "source",
      "ref": "DW10 database schema (INFORMATION_SCHEMA of a local DW10 install) and Dynamicweb.Ecommerce 10.29.8"
    }
  ]
}
