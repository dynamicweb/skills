      "surface": "sql",
      "status": "implemented",
      "handler": "sql-scalar",
      "query": "SELECT COUNT(*) FROM Page WHERE PageNavigationTag = 'Shop' AND PageDeleted = 0",
      "localOnly": true
    }
  ],
