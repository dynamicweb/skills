{
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "lock": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "checkIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "commit",
        "manifest",
        "digest",
        "checkIds"
      ],
      "additionalProperties": false
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]*$"
      }
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "defaultLanguage": {
      "type": "string",
      "minLength": 1
    },
    "pimShop": {
      "type": "string",
      "minLength": 1
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "productScope": {
      "type": "object"
    },
    "editLayout": {
      "type": "object",
      "properties": {
        "division": {
          "enum": [
            "role",
            "task",
            "lifecycle",
            "source"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "\\S"
              },
              "for": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "owner": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "for"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "division",
        "reason"
      ],
      "additionalProperties": false
    },
    "rulings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "applies": {
            "type": "boolean"
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "applies"
        ],
        "if": {
          "properties": {
            "applies": {
              "const": false
            }
          }
        },
        "then": {
          "required": [
            "rule",
            "evidence"
          ]
        }
      }
    },
    "expected": {
      "type": "object"
    },
    "areaId": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema",
    "slug",
    "lock",
    "functions"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
